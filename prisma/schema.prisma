generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id                  String   @id @default(cuid())
  name                String
  englishName         String?
  email               String?
  phone               String?
  avatar              String?
  gender              String   @default("Male")
  dob                 String?
  status              String   @default("wait_for_assignment")
  branch              String?  @default("CS1")
  schoolName          String?
  parentName          String?
  parentPhone         String?
  packageName         String?
  packageSessions     Int      @default(0)
  usedSessions        Int      @default(0)
  remainingSessions   Int      @default(0)
  notes               String?
  placementAttempt    Int      @default(1)
  enrolledClassesJson String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Branch {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  type                String   @default("training_center")
  typeLabel           String?
  region              String?  @default("Miền Bắc")
  province            String?  @default("Hà Nội")
  district            String?
  address             String?
  phone               String?
  email               String?
  coordinates         String?
  status              String   @default("active")
  statusLabel         String?
  managerId           String?
  managerName         String?
  managerPhone        String?
  managerEmail        String?
  managerAvatar       String?
  roomCount           Int      @default(0)
  totalCapacity       Int      @default(0)
  activeClassesCount  Int      @default(0)
  activeStudentsCount Int      @default(0)
  roomsJson           String?
  staffJson           String?
  businessHoursJson   String?
  historyJson         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ClassRecord {
  id                     String   @id @default(cuid())
  code                   String   @unique
  name                   String
  level                  String   @default("Beginner")
  subLevel               String?
  subject                String?  @default("Tiếng Anh")
  grade                  String?
  branch                 String?  @default("CS1")
  room                   String?  @default("P.101")
  teacher                String?
  teacherPhone           String?
  assistant              String?
  assistantPhone         String?
  schedule               String?
  startDate              String?
  endDate                String?
  status                 String   @default("cho_khai_giang")
  maxStudents            Int      @default(20)
  enrolledStudents       Int      @default(0)
  tuitionFee             Int      @default(0)
  totalSessions          Int      @default(24)
  completedSessions      Int      @default(0)
  trialStudents          Int      @default(0)
  specialCareCount       Int      @default(0)
  attendanceRate         Float?   @default(100)
  homeworkRate           Float?   @default(100)
  avgTestScore           Float?   @default(0)
  classType              String?  @default("Chính thức")
  classRatio             String?
  teacherType            String?
  learningPath           String?
  syllabus               String?
  curriculumName         String?
  programName            String?
  packageName            String?
  notes                  String?
  scheduleSlotsJson      String?
  substituteTeachersJson String?
  teacherHistoryJson     String?
  nextSessionJson        String?
  lastSessionJson        String?
  studentsJson           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model QcIncident {
  id                 String   @id @default(cuid())
  code               String   @unique
  title              String
  targetGroup        String   // teacher | facility | operations
  criteria           String   // attendance | student_care | facility_quality | pedagogy | feedback | safety_hygiene
  source             String   @default("manual") // manual | system
  severity           String   @default("medium") // low | medium | high | critical
  status             String   @default("open")   // open | correcting | corrected | closed | not_met | cancelled

  // Ngữ cảnh phát sinh
  branch                String
  classId               String?
  className             String?
  subject               String?
  sessionNumber         Int?
  sessionDate           String?
  sessionInfo           String?
  roomId                String?

  // Nhân sự liên quan
  teacherId             String?
  teacherName           String?
  csmId                 String?
  csmName               String?
  assignee              String   // Người chịu trách nhiệm khắc phục
  issuedBy              String   // Người hoặc Hệ thống tạo lỗi

  // Chi tiết lỗi & Bằng chứng
  description           String
  recurrenceCount       Int      @default(0)
  evidence              String?
  evidenceImage         String?
  evidenceLink          String?
  deadline              String?

  // Biện pháp khắc phục & Bằng chứng xử lý
  correctiveAction      String?
  correctiveEvidence    String?
  correctiveImage       String?
  correctiveLink        String?
  preventiveAction      String?
  completionDate        String?

  // Đóng & Phúc tra
  closureMethod         String?  // manual | system_auto
  closedBy              String?
  closedAt              String?
  notes                 String?

  // Trao đổi thảo luận & Lịch sử vết (JSON)
  remediationRoundsJson String?
  commentsJson          String?
  logsJson              String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([assignee, branch])
  @@index([status])
  @@index([createdAt])
}
